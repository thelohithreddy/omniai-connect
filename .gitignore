# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/

# Builds
.next/
out/
dist/
build/
*.egg-info/
.turbo/
# tsc --incremental cache. Machine-specific, ~130 KB, and regenerated on every
# typecheck — committing it produces noisy diffs and merge conflicts for zero value.
*.tsbuildinfo

# Env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# Test & coverage
coverage/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
logs/

# Misc
.vercel
.railway

# Celery beat's persistent schedule database — runtime state written by the scheduler
# container, not source. Committing it would ship a last-run timestamp that could make a
# fresh deployment skip or misschedule a sweep.
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
