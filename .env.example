# ============================================================
# OmniAI Connect — Environment Template
# Copy to .env and fill in. NEVER commit real values.
# Every variable used anywhere in the codebase MUST be listed
# here with a placeholder — see docs/SECURITY.md.
# ============================================================

# --- Core ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL — Neon in prod, Docker locally) ---
# DATABASE_URL uses the *application* role: not superuser, not table owner, no BYPASSRLS.
# Row-Level Security exempts superusers unconditionally and table owners unless FORCE is
# set, so connecting as either would silently disable tenant isolation (DATABASE_DESIGN §6).
DATABASE_URL=postgresql+asyncpg://omniai_app:omniai_app@localhost:5432/omniai
# DATABASE_ADMIN_URL owns the schema and runs Alembic. Never used to serve requests.
DATABASE_ADMIN_URL=postgresql+asyncpg://omniai:omniai@localhost:5432/omniai

# --- Cache / Queue (Redis — Upstash in prod, Docker locally) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Better Auth) ---
# Signs session cookies and encrypts the JWT private key at rest in `identity.jwks`.
# Must be >=32 chars and randomly generated — Better Auth rejects low-entropy secrets at
# boot. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Better Auth owns the `identity` schema through its own role. Deliberately NOT the
# application DSN: omniai_app has no privileges on `identity`, and omniai_identity has none
# on the application tables, so a compromise of either credential cannot read the other's
# data. `search_path` is set by the pool in apps/web/src/lib/auth.ts.
BETTER_AUTH_DATABASE_URL=postgresql://omniai_identity:omniai_identity@localhost:5432/omniai
# Where the API fetches the JWKS when that differs from BETTER_AUTH_URL (container
# networking only — ADR-0015 §5). Empty derives {BETTER_AUTH_URL}/api/auth/jwks.
# The issuer/audience the verifier pins is always BETTER_AUTH_URL itself.
BETTER_AUTH_JWKS_URL=

# --- Encryption (credential vault — see docs/SECURITY.md §2.1) ---
# Wraps per-Credential data keys (envelope encryption). Rotating it re-wraps DEKs; it
# never re-encrypts payloads. Migrates to a KMS before Team/Enterprise.
# This is KEK **version 1** and always will be: rows stamped key_version=1 were wrapped by this
# key directly, so its meaning can never be reassigned.
CREDENTIAL_MASTER_KEY=change-me-generate-with-scripts/gen-key.sh
# Additional KEK versions for a rotation, as `version:base64key` (comma-separated), versions >= 2
# only. Empty = single-key operation, which is the normal steady state. During a rotation both the
# old and new versions stay listed — that overlap is what keeps un-rotated credentials readable.
# Example: CREDENTIAL_MASTER_KEYS=2:<base64-32-bytes>
CREDENTIAL_MASTER_KEYS=
# Which version seals NEW credentials. Bumping this is step 1 of the rotation runbook
# (INTRODUCE); the re-wrap sweep then migrates existing rows toward it. Must exist in the keyring
# above or the API refuses to boot.
CREDENTIAL_KEY_VERSION=1
# Operational lever for the re-wrap sweep. False pauses re-wrapping only; it never weakens an
# already-sealed credential.
CREDENTIAL_ROTATION_ENABLED=true
# How often the re-wrap sweep ticks, in seconds. Idle cost is one indexed COUNT.
CREDENTIAL_ROTATION_SWEEP_SECONDS=300

# --- Connection Health (see docs/ROADMAP.md §58, ADR-0040) ---
# Kill switch for the health-check endpoint. False makes it refuse before any lookup, execution,
# credential access or state mutation.
CONNECTION_HEALTH_ENABLED=true

# --- Connection Health failure notifications (M2.10, ADR-0042) ---
# Kill switch for notification *delivery* only. False stops mail; it never changes a health
# verdict, a timestamp, or an audit row — notification has no authority over health.
CONNECTION_HEALTH_NOTIFICATIONS_ENABLED=true
# The dedup window: at most one notification winner per Connection per failure event type
# within this many seconds. This is the notification cadence, deliberately chosen — and it is
# NOT durable exactly-once delivery: a Redis flush or eviction re-arms the key and permits one
# duplicate message (accepted, ADR-0042).
HEALTH_NOTIFICATION_DEDUP_TTL_SECONDS=86400

# --- Frontend ---
# PUBLIC. Everything prefixed NEXT_PUBLIC_ is compiled into the browser bundle, so a secret
# placed here is a published secret (FRONTEND_SPEC §9). Only put values here that are safe to
# hand to any visitor.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy. The control plane does NOT use this: the browser never calls FastAPI directly
# (ADR-0044) — there is no CORS middleware on the API, and the planned CSP pins
# `connect-src 'self'`. Server-side calls use API_BASE_URL below. Do not introduce a
# browser-side API client that reads this.
NEXT_PUBLIC_API_URL=http://localhost:8000

# SERVER-ONLY. Where the Next server reaches FastAPI (MC1.1, ADR-0044 D2). Deliberately not
# NEXT_PUBLIC_: in a container deployment this is an internal address (http://api:8000) that
# is not the public one, and publishing it would advertise an origin the browser must never
# use. Required — there is no production fallback; a missing value fails loudly at startup.
API_BASE_URL=http://localhost:8000
# Bounded timeout for one backend request, in milliseconds. An unbounded server fetch holds a
# render open until the platform kills it, turning one slow backend into a stalled control plane.
API_TIMEOUT_MS=10000

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
# From address for first-party invitation email (ADR-0017). Not a secret — it appears in
# every message header. Has a safe default; set to a domain verified in Resend for real send.
INVITATION_FROM_EMAIL="OmniAI Connect <invites@omni.example>"
# From address for Connection Health failure notifications (M2.10, ADR-0042). Separate from the
# invitation sender so an operational alert does not arrive from an address named "invites", and
# so a deliverability problem with one class of mail can be diagnosed without touching the other.
NOTIFICATION_FROM_EMAIL="OmniAI Connect <alerts@omni.example>"

# --- Monitoring ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Object storage (S3-compatible: Cloudflare R2 in prod, MinIO locally) ---
# Production: point R2_ENDPOINT at the R2 account endpoint (https://<acct>.r2.cloudflarestorage.com)
# and set the R2 access key / secret / bucket. Local dev via docker-compose overrides these to the
# MinIO service (http://minio:9000, minioadmin/minioadmin) — you do not need real R2 to run locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omniai-dev
R2_ENDPOINT=
R2_REGION=auto

# --- MCP interface (ADR-0035) ---
# TTL backstop (seconds) for the per-workspace MCP tools-discovery cache. Events evict eagerly;
# this bounds staleness if an eviction is lost. Founder-ratified default: 300.
MCP_TOOLS_CACHE_TTL_SECONDS=300

# --- Tool-Call rate limits & quotas (M2.4, ADR-0037; founder-ratified D1) ---
# Kill switch: false restores exact pre-M2.4 behavior (no checks, no counting).
RATE_LIMITING_ENABLED=true
# Free-plan workspace token bucket (sustained per-minute rate + burst capacity) and the
# weekly quota of executed Tool Calls (ISO week, UTC reset). Paid plans unenforced until M3.
FREE_WORKSPACE_RATE_PER_MINUTE=60
FREE_WORKSPACE_BURST=10
FREE_WEEKLY_QUOTA=1000

# --- OAuth 2.0 authorization-code flow (M2.5, ADR-0038) ---
# Kill switch: false makes the OAuth endpoints refuse and the refresh worker no-op. It never
# weakens an already-issued credential.
OAUTH_ENABLED=true
# The ONE redirect URI registered with every provider — server-configured and exact-match.
# Production must be the https callback of the API host, e.g. https://api.example.com/v1/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/v1/oauth/callback
# How long an in-flight authorization stays redeemable, and how aggressively tokens are renewed.
OAUTH_STATE_TTL_SECONDS=600
OAUTH_REFRESH_THRESHOLD_RATIO=0.25
OAUTH_REFRESH_MAX_ATTEMPTS=5
