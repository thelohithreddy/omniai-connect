# ============================================================
# OmniAI Connect — Environment Template
# Copy to .env and fill in. NEVER commit real values.
# Every variable used anywhere in the codebase MUST be listed
# here with a placeholder — see docs/SECURITY.md.
# ============================================================

# --- Core ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL — Neon in prod, Docker locally) ---
# DATABASE_URL uses the *application* role: not superuser, not table owner, no BYPASSRLS.
# Row-Level Security exempts superusers unconditionally and table owners unless FORCE is
# set, so connecting as either would silently disable tenant isolation (DATABASE_DESIGN §6).
DATABASE_URL=postgresql+asyncpg://omniai_app:omniai_app@localhost:5432/omniai
# DATABASE_ADMIN_URL owns the schema and runs Alembic. Never used to serve requests.
DATABASE_ADMIN_URL=postgresql+asyncpg://omniai:omniai@localhost:5432/omniai

# --- Cache / Queue (Redis — Upstash in prod, Docker locally) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Better Auth) ---
# Signs session cookies and encrypts the JWT private key at rest in `identity.jwks`.
# Must be >=32 chars and randomly generated — Better Auth rejects low-entropy secrets at
# boot. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Better Auth owns the `identity` schema through its own role. Deliberately NOT the
# application DSN: omniai_app has no privileges on `identity`, and omniai_identity has none
# on the application tables, so a compromise of either credential cannot read the other's
# data. `search_path` is set by the pool in apps/web/src/lib/auth.ts.
BETTER_AUTH_DATABASE_URL=postgresql://omniai_identity:omniai_identity@localhost:5432/omniai

# --- Encryption (credential vault — see docs/SECURITY.md §2.1) ---
# Wraps per-Credential data keys (envelope encryption). Rotating it re-wraps DEKs; it
# never re-encrypts payloads. Migrates to a KMS before Team/Enterprise.
CREDENTIAL_MASTER_KEY=change-me-generate-with-scripts/gen-key.sh

# --- Frontend ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx

# --- Monitoring ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omniai-dev
