# ============================================================
# OmniAI Connect — Environment Template
# Copy to .env and fill in. NEVER commit real values.
# Every variable used anywhere in the codebase MUST be listed
# here with a placeholder — see docs/SECURITY.md.
# ============================================================

# --- Core ---
APP_ENV=development                # development | staging | production
LOG_LEVEL=debug

# --- Database (PostgreSQL — Neon in prod, Docker locally) ---
DATABASE_URL=postgresql+asyncpg://omniai:omniai@localhost:5432/omniai

# --- Cache / Queue (Redis — Upstash in prod, Docker locally) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000

# --- Encryption (credential vault — see docs/SECURITY.md) ---
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-scripts/gen-key.sh

# --- Frontend ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx

# --- Monitoring ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omniai-dev
